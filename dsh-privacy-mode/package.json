{
  "name": "dsh-privacy-mode",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Asymmetric visibility modes for DeepSeek Harness: in NORMAL, marked plugins, workspaces and sessions do not exist; in PRIVATE, everything is visible again.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "privacy",
    "visibility",
    "agent-preset"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./tools": "./tools.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "tools.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "author": {
    "name": "huiyaoxingkong",
    "url": "https://github.com/huiyaoxingkong"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiyaoxingkong/dsh-privacy-mode.git",
    "directory": "dsh-privacy-mode"
  },
  "homepage": "https://github.com/huiyaoxingkong/dsh-privacy-mode#readme",
  "bugs": {
    "url": "https://github.com/huiyaoxingkong/dsh-privacy-mode/issues"
  }
}
